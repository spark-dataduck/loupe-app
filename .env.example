# ─────────────────────────────────────────────────────────────────────────────
# Loupe ingest app — environment
# Copy to .env.local for local dev; set the same keys in the Vercel project.
# NONE of these are exposed to the browser (no NEXT_PUBLIC_ prefix).
# ─────────────────────────────────────────────────────────────────────────────

# Demo-org read-write token — triggers/polls flights and runs UPDATE SHARE.
# Locally: copy the value of DEMO_MOTHERDUCK_TOKEN from note-summary/.env.
MOTHERDUCK_TOKEN=

# Deployed flight + dive IDs (demo org). Defaults baked into lib/config.ts;
# override here only if they change.
PARSE_FLIGHT_ID=c72f3404-a5b3-49e1-b8dc-36ef4e3c3ca4
EMBED_INDEX_FLIGHT_ID=ef18ded7-b3d3-4084-a708-0e92c946715c
LOUPE_DIVE_ID=8e4a1ad4-6087-43c0-8b82-d5acbf58b3cf

# Org-scoped share of document_search. The Dive's REQUIRED_DATABASES already points
# at it; the app refreshes it via UPDATE SHARE after each run. (Kept for reference.)
MD_SHARE_URL=md:_share/document_search/540bd0c4-2719-4792-998d-3e8a60529acc

# Embedding the Dive. You only need ONE new thing: a dedicated, EMPTY service account,
# and its USERNAME here (the Dive runs AS this account, read-only; empty so the share
# alias `document_search` doesn't collide with a DB it owns). The admin bearer that mints
# the session defaults to MOTHERDUCK_TOKEN above (it's an org-admin token) — same pattern
# as the embedded-dive-test reference.
MD_EMBED_SERVICE_ACCOUNT=
# Optional: only set this to mint sessions with a DIFFERENT admin token than
# MOTHERDUCK_TOKEN. Leave blank to reuse MOTHERDUCK_TOKEN.
MD_EMBED_ADMIN_TOKEN=

# Vercel Blob — auto-provisioned when you connect a Blob store on Vercel.
# Without it, local uploads are disabled and the URL-paste path still works.
BLOB_READ_WRITE_TOKEN=
